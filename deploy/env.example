# /etc/shikhon/shikhon.env  — the real file is root-owned 0600 and NEVER committed.
# Every value below is a placeholder; generate real ones on the server.

# ── Where the app listens (private docker-bridge IP; Caddy reverse-proxies here) ──
HOST=172.16.1.1
PORT=4100
APP_ENV=production
NODE_ENV=production

# ── Database — three roles, none with BYPASSRLS (the app asserts this at boot) ──
# app = the runtime (RLS-bound), platform = the operator console, maintenance = owner.
DATABASE_URL=postgres://shikhon_app:CHANGE_ME@127.0.0.1:5432/shikhon_lms
PLATFORM_DATABASE_URL=postgres://shikhon_platform:CHANGE_ME@127.0.0.1:5432/shikhon_lms
DATABASE_MAINTENANCE_URL=postgres://shikhon_owner:CHANGE_ME@127.0.0.1:5432/shikhon_lms

# ── Auth (EdDSA JWT) — scripts/generate-jwt-keys.mjs ──
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ── Platform / service credentials — openssl rand -hex 32 ──
SERVICE_API_KEY=
# SERVICE_API_KEY_NEXT=          # set only during a key rotation
CRON_SECRET=
PLATFORM_API_KEY=
ACTIVATION_PEPPER=
PII_MASTER_KEY_V1=

# ── CORS: only the real origin may read an authenticated response ──
ALLOWED_ORIGINS=https://sikhon.systems

# ── Web push (RFC 8291/8292) — scripts/generate-vapid-keys.mjs ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@sikhon.systems

# ── Off until the external dependency arrives (see docs/12-PRODUCTION-RUNBOOK.md) ──
# OTP_SENDING_ENABLED=true       # needs a real SMS aggregator + an allowlist first
# SMS_PROVIDER=
# SMS_ENDPOINT=
# SMS_API_TOKEN=
# SMS_SENDER_ID=
# SMS_DLR_SECRET=
# SMS_TEST_RECIPIENTS=           # set BEFORE the first dispatch, or real guardians get texted
# ALERT_WEBHOOK_URL=             # https webhook; until set, the monitor logs but pages nobody
# ANTHROPIC_API_KEY=             # SikhokAI; off until provided
# WILDCARD_DNS_READY=            # leave unset — tenant subdomains use /app?tid= for now

# ── Read by a running service, and previously undocumented here (P13) ──
#
# An operator provisions production from this file, so a variable a service
# reads and this template omits is a silent misconfiguration: the deployment
# starts, and the behaviour is whatever the fallback happens to be. These five
# were found by diffing `process.env.*` across services/ and packages/ against
# this file.

# The SMS worker has no tenant context of its own — it is a cron, not a
# request. This is the comma-separated list of schools whose queues it drains.
# EMPTY MEANS NO SCHOOL IS DRAINED: the queue fills and nothing sends, which
# looks exactly like a broken aggregator. Set it when SMS goes live.
# SMS_WORKER_TENANT_IDS=

# Refuses a service key that asks to act for a different tenant. Under
# NODE_ENV=production the switch is denied unless this is explicitly set, so
# leaving it unset is the safe state and setting it is a deliberate act.
# SERVICE_KEY_TENANT_SWITCH=

# Outbound signing key for the ANS event feed. Unset means events are not
# signed, and a consumer cannot tell our events from anyone else's.
# ANS_SIGNING_SECRET=

# Model ids for the two AI surfaces. Both default in code, so these exist to
# pin a version rather than to enable anything — worth setting explicitly in
# production so a model change is a deploy, not a surprise.
# AI_MODEL_SIKHOK=claude-opus-5
# AI_MODEL_SHIKHO=claude-haiku-4-5-20251001
